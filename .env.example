# Copy to .env for local overrides. Real .env is gitignored.
GATEWAY_PORT=8080
POSTGRES_PASSWORD=postgres-dev-only
CONTROL_DB_PASSWORD=control-dev-only
# Prefix of seeded demo API keys: <prefix>-a-console, <prefix>-a-agent, <prefix>-mcp, <prefix>-admin, <prefix>-worker
SEED_KEY_PREFIX=dev
# Local envelope-encryption master key lives in .local/dev-master.key (generated by scripts/dev-up.sh)
SECRETS_BACKEND=local
MAX_RESPONSE_BYTES=10485760
FAULT=
